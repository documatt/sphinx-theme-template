{
  "scripts": {
    "theme:build": "npx @tailwindcss/cli -i ./src/{{ project_slug }}/static/styles/input.css -o ./src/{{ project_slug }}/static/styles/output.css",
    "theme:watch": "concurrently -n 'theme:watch' -c 'blue' \"npm run theme:build -- --watch\""
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "concurrently": "^9.1.2",
    "prettier": "3.3.3",
    "prettier-plugin-jinja-template": "^2.0.0",
    "prettier-plugin-tailwindcss": "^0.6.11",
    "tailwindcss": "^4.0.14"
  }
}
